# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.node-local

# database
/prisma/dev.db
/prisma/*.db-journal
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# claude code local settings (machine-specific, not for sharing)
.claude/settings.local.json

# app mobile (Capacitor) — artefacts régénérables, pas versionnés
/android/app/build
/android/.gradle
/android/local.properties
/android/captures
/android/.idea
/ios/App/Pods
/ios/App/build
/ios/App/App.xcworkspace/xcuserdata
/ios/App/App.xcodeproj/xcuserdata
/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata
