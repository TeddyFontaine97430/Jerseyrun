// Jersey Run — schéma de données
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLUB
  CUSTOMER
}

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  STRIPE
  ON_SITE
}

enum ProductAvailability {
  IN_STOCK
  PREORDER
}

enum SupplyOrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String?
  role                Role                 @default(CUSTOMER)
  club                Club?
  cartItems           CartItem[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ClubRegistrationCode {
  id           String   @id @default(cuid())
  email        String   @unique
  code         String
  name         String
  sport        String
  phone        String
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Club {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  phone       String
  email       String
  sport       String?
  description String?
  logoUrl     String?
  status      ClubStatus  @default(PENDING)
  active      Boolean     @default(true)
  stripeAccountId      String?  @unique
  stripePayoutsEnabled Boolean  @default(false)
  allowPayOnSite       Boolean  @default(false)
  termsAcceptedAt      DateTime?
  owner       User        @relation(fields: [ownerId], references: [id])
  ownerId     String      @unique
  products    Product[]
  orderItems  OrderItem[]
  supplyOrders SupplyOrder[]
  createdAt   DateTime    @default(now())
}

model Product {
  id                      String          @id @default(cuid())
  club                    Club            @relation(fields: [clubId], references: [id])
  clubId                  String
  name                    String
  description             String?
  priceCents              Int
  imageUrl                String?
  stock                   Int             @default(0)
  active                  Boolean             @default(true)
  availability            ProductAvailability @default(IN_STOCK)
  personalizationEnabled  Boolean         @default(false)
  personalizationFeeCents Int             @default(0)
  options                 ProductOption[]
  cartItems               CartItem[]
  orderItems              OrderItem[]
  createdAt               DateTime        @default(now())
}

model ProductOption {
  id        String               @id @default(cuid())
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  values    ProductOptionValue[]
  createdAt DateTime             @default(now())
}

model ProductOptionValue {
  id        String        @id @default(cuid())
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId  String
  value     String
  stock     Int           @default(0)
  createdAt DateTime      @default(now())

  @@unique([optionId, value])
}

model CartItem {
  id                  String   @id @default(cuid())
  user                User     @relation(fields: [userId], references: [id])
  userId              String
  product             Product  @relation(fields: [productId], references: [id])
  productId           String
  quantity            Int      @default(1)
  selectedOptions     String?
  personalizationText String?
  createdAt           DateTime @default(now())
}

model Order {
  id                 String      @id @default(cuid())
  user               User        @relation(fields: [userId], references: [id])
  userId             String
  status             OrderStatus    @default(PENDING)
  totalCents         Int
  deliveryMethod     DeliveryMethod @default(DELIVERY)
  deliveryFeeCents   Int            @default(0)
  paymentMethod      PaymentMethod  @default(STRIPE)
  stripeSessionId    String?        @unique
  customerName       String?
  customerPhone      String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingPostalCode String?
  shippingCountry    String?
  invoiceNumber      String?        @unique
  invoicedAt         DateTime?
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model OrderItem {
  id                  String  @id @default(cuid())
  order               Order   @relation(fields: [orderId], references: [id])
  orderId             String
  product             Product @relation(fields: [productId], references: [id])
  productId           String
  club                Club    @relation(fields: [clubId], references: [id])
  clubId              String
  quantity            Int
  unitPriceCents      Int
  productName         String
  selectedOptions     String?
  personalizationText String?
  delivered           Boolean @default(false)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model SupplyProduct {
  id          String            @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  priceCents  Int
  active      Boolean           @default(true)
  orderItems  SupplyOrderItem[]
  createdAt   DateTime          @default(now())
}

model SupplyOrder {
  id        String            @id @default(cuid())
  club      Club              @relation(fields: [clubId], references: [id])
  clubId    String
  status    SupplyOrderStatus @default(PENDING)
  note      String?
  items     SupplyOrderItem[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model SupplyOrderItem {
  id             String        @id @default(cuid())
  order          SupplyOrder   @relation(fields: [orderId], references: [id])
  orderId        String
  product        SupplyProduct @relation(fields: [productId], references: [id])
  productId      String
  productName    String
  quantity       Int
  unitPriceCents Int
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
