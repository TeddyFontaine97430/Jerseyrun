// Jersey Run — schéma de données
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLUB
  CUSTOMER
  SUPPLIER
}

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
  DELIVERY_METROPOLE
  DELIVERY_REUNION
}

enum PaymentMethod {
  STRIPE
  ON_SITE
}

enum ProductAvailability {
  IN_STOCK
  PREORDER
}

enum SupplyOrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String?
  role                Role                 @default(CUSTOMER)
  club                Club?
  supplier            Supplier?
  cartItems           CartItem[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ClubRegistrationCode {
  id           String   @id @default(cuid())
  email        String   @unique
  code         String
  name         String
  sport        String
  phone        String
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Club {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  phone       String
  email       String
  sport       String?
  description String?
  logoUrl     String?
  status      ClubStatus  @default(PENDING)
  active      Boolean     @default(true)
  stripeAccountId      String?  @unique
  stripePayoutsEnabled Boolean  @default(false)
  allowPayOnSite       Boolean  @default(false)
  deliveryMetropoleEnabled        Boolean @default(false)
  deliveryMetropoleFeeCents       Int     @default(0)
  deliveryMetropoleExtraItemCents Int     @default(0)
  deliveryReunionEnabled          Boolean @default(false)
  deliveryReunionFeeCents         Int     @default(0)
  deliveryReunionExtraItemCents   Int     @default(0)
  termsAcceptedAt      DateTime?
  owner       User        @relation(fields: [ownerId], references: [id])
  ownerId     String      @unique
  products    Product[]
  orderItems  OrderItem[]
  supplyOrders SupplyOrder[]
  supplyProducts SupplyProduct[]
  contactMessages ContactMessage[]
  createdAt   DateTime    @default(now())
}

model Product {
  id                      String          @id @default(cuid())
  club                    Club            @relation(fields: [clubId], references: [id])
  clubId                  String
  name                    String
  description             String?
  priceCents              Int
  imageUrl                String?
  stock                   Int             @default(0)
  active                  Boolean             @default(true)
  availability            ProductAvailability @default(IN_STOCK)
  personalizationEnabled  Boolean         @default(false)
  personalizationFeeCents Int             @default(0)
  options                 ProductOption[]
  images                  ProductImage[]
  cartItems               CartItem[]
  orderItems              OrderItem[]
  createdAt               DateTime        @default(now())
}

model ProductImage {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductOption {
  id        String               @id @default(cuid())
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  values    ProductOptionValue[]
  createdAt DateTime             @default(now())
}

model ProductOptionValue {
  id        String        @id @default(cuid())
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  optionId  String
  value     String
  stock     Int           @default(0)
  createdAt DateTime      @default(now())

  @@unique([optionId, value])
}

model CartItem {
  id                  String   @id @default(cuid())
  user                User     @relation(fields: [userId], references: [id])
  userId              String
  product             Product  @relation(fields: [productId], references: [id])
  productId           String
  quantity            Int      @default(1)
  selectedOptions     String?
  personalizationText String?
  createdAt           DateTime @default(now())
}

model Order {
  id                 String      @id @default(cuid())
  user               User?       @relation(fields: [userId], references: [id])
  userId             String?
  status             OrderStatus    @default(PENDING)
  totalCents         Int
  deliveryMethod     DeliveryMethod @default(DELIVERY)
  deliveryFeeCents   Int            @default(0)
  paymentMethod      PaymentMethod  @default(STRIPE)
  stripeSessionId    String?        @unique
  isManualOrder      Boolean        @default(false)
  customerName       String?
  customerEmail      String?
  customerPhone      String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingPostalCode String?
  shippingCountry    String?
  invoiceNumber      String?        @unique
  invoicedAt         DateTime?
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model OrderItem {
  id                  String  @id @default(cuid())
  order               Order   @relation(fields: [orderId], references: [id])
  orderId             String
  product             Product @relation(fields: [productId], references: [id])
  productId           String
  club                Club    @relation(fields: [clubId], references: [id])
  clubId              String
  quantity            Int
  unitPriceCents      Int
  productName         String
  selectedOptions     String?
  personalizationText String?
  readyForPickup      Boolean @default(false)
  delivered           Boolean @default(false)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  club      Club?    @relation(fields: [clubId], references: [id])
  clubId    String?
  createdAt DateTime @default(now())
}

model SupplyProduct {
  id                     String            @id @default(cuid())
  // Un article est réservé à un club (son maillot, sa tenue...). Laissez vide pour un
  // article générique visible par tous les clubs (ex: accessoires communs).
  club                   Club?             @relation(fields: [clubId], references: [id])
  clubId                 String?
  name                   String
  description            String?
  imageUrl               String?
  priceCents             Int
  active                 Boolean           @default(true)
  sizes                  String[]          @default([])
  personalizationEnabled Boolean           @default(false)
  orderItems             SupplyOrderItem[]
  createdAt              DateTime          @default(now())
}

model SupplyOrder {
  id          String            @id @default(cuid())
  club        Club              @relation(fields: [clubId], references: [id])
  clubId      String
  orderNumber String?           @unique
  status      SupplyOrderStatus @default(PENDING)
  note        String?
  items       SupplyOrderItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model SupplyOrderItem {
  id                  String        @id @default(cuid())
  order               SupplyOrder   @relation(fields: [orderId], references: [id])
  orderId             String
  product             SupplyProduct @relation(fields: [productId], references: [id])
  productId           String
  productName         String
  quantity            Int
  unitPriceCents      Int
  size                String?
  personalizationText String?
  supplier            Supplier?     @relation(fields: [supplierId], references: [id])
  supplierId          String?
  sentToSupplierAt    DateTime?
}

model Supplier {
  id         String            @id @default(cuid())
  name       String
  email      String
  phone      String?
  notes      String?
  active     Boolean           @default(true)
  owner      User?             @relation(fields: [ownerId], references: [id])
  ownerId    String?           @unique
  orderItems SupplyOrderItem[]
  createdAt  DateTime          @default(now())
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Bande d'images cliquables affichée sur la page d'accueil, entre le bandeau
// principal et la bannière du club mis en avant. Chaque image a son propre lien.
model HomeGalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  link      String
  createdAt DateTime @default(now())
}

enum PushPlatform {
  ANDROID
  IOS
}

// Un appareil ayant installé l'app mobile et accepté les notifications.
// Le token FCM est fourni par Firebase Cloud Messaging côté app.
model PushDevice {
  id         String       @id @default(cuid())
  token      String       @unique
  platform   PushPlatform
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @updatedAt
}

// Historique des notifications envoyées depuis l'administration.
model PushNotification {
  id         String   @id @default(cuid())
  title      String
  body       String   @db.Text
  imageUrl   String?
  sentCount  Int      @default(0)
  failCount  Int      @default(0)
  sentByName String?
  createdAt  DateTime @default(now())
}
